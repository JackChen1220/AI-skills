{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepairAction",
  "type": "object",
  "required": ["card_id", "failure_codes", "repair_layer", "action", "result_state"],
  "properties": {
    "card_id": {"type": "string", "minLength": 1},
    "failure_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "repair_layer": {"enum": ["data", "grouping", "scene_brief", "layout", "prompt", "base_illustration", "composition", "connector"]},
    "action": {"type": "string", "minLength": 1},
    "result_state": {"enum": ["REVISED", "GENERATED", "COMPOSED"]},
    "created_at": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
