{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneBrief",
  "type": "object",
  "required": ["scene_id","targets","scene_type","template_id","composition","target_specs","forbidden"],
  "properties": {
    "scene_id": {"type": "string"},
    "targets": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"type": "string"}},
    "scene_type": {"type": "string"},
    "template_id": {"type": "string"},
    "main_subjects": {"type": "array","items": {"type": "string"}},
    "environment": {"type": ["string","null"]},
    "composition": {"type": "string"},
    "pose_actions": {"type": "array","items": {"type": "string"}},
    "target_specs": {
      "type": "array","minItems": 1,
      "items": {
        "type": "object",
        "required": ["term","mapping_mode","anchor_description","connector_policy","label_zone"],
        "properties": {
          "term": {"type": "string"},
          "mapping_mode": {"enum": ["direct_anchor","action_anchor","scene_state","dialogue_phrase","timeline_segment","comparison_zone","relation_anchor"]},
          "anchor_description": {"type": "string"},
          "connector_policy": {"enum": ["required","optional","none"]},
          "label_zone": {"type": "string"},
          "pedagogical_note": {"type": ["string","null"]}
        },
        "additionalProperties": true
      }
    },
    "visual_priority": {"type": "array","items": {"type": "string"}},
    "forbidden": {"type": "array","items": {"type": "string"}},
    "notes": {"type": ["string","null"]}
  },
  "additionalProperties": true
}