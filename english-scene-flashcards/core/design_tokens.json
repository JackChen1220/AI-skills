{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "token_set": "flashcard.visual.v2",
  "version": "2.3.1",
  "canvas_reference": {
    "width": 1536,
    "height": 2048,
    "orientation": "portrait"
  },
  "label_card": {
    "fill": "#FFFFFF",
    "fill_opacity": 0.98,
    "corner_radius_ratio": 0.018,
    "shadow": "subtle",
    "border": "none_or_hairline",
    "padding_ratio_x": 0.024,
    "padding_ratio_y": 0.016
  },
  "typography": {
    "english": {
      "role": "dominant",
      "color": "#0E2B6D",
      "weight": "bold",
      "preferred_size_px_at_1536w": [60, 76],
      "hard_min_px_at_1536w": 54
    },
    "ipa": {
      "role": "secondary",
      "color": "#56677F",
      "preferred_size_px_at_1536w": [32, 42],
      "hard_min_px_at_1536w": 28,
      "font_requirement": "full IPA glyph coverage"
    },
    "chinese": {
      "role": "secondary",
      "color": "#333333",
      "preferred_size_px_at_1536w": [32, 42],
      "hard_min_px_at_1536w": 28,
      "font_requirement": "CJK glyph coverage"
    }
  },
  "connector": {
    "token": "connector.v3.light",
    "line_color": "#B7C6D8",
    "line_opacity": 0.78,
    "line_width_px_at_1536w": [2, 3],
    "endpoint_dot_diameter_px_at_1536w": [6, 8],
    "endpoint_dot_color": "#A1B4CA",
    "start_dot": false,
    "shadow": false,
    "glow": false,
    "forbidden_anchor_colors": ["red", "orange", "yellow"]
  }
}
